{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chengdu-job-radar",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Set this database UUID from the Wrangler create command before remote deployment.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chengdu-job-radar",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 1 * * *"]
  }
}
